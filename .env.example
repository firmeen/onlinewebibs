# Set in your PowerShell environment; do not commit real secrets.
OIC_BEARER_TOKEN=REPLACE_WITH_YOUR_OWN_FRESH_AUTHORIZED_TOKEN
# Optional: required only if the service validates browser session cookies
OIC_COOKIE=
SQL_SERVER=YOUR_SQL_SERVER
SQL_PORT=1433
SQL_DATABASE=YOUR_DATABASE
SQL_USER=YOUR_USERNAME
SQL_PASSWORD=YOUR_PASSWORD